# Neon Postgres connection (Pooled, sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# JWT secret (random, >= 32 chars)
JWT_SECRET=please-replace-me-with-a-very-long-random-string-32chars+

# Single admin account (seeded into DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Public site config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=WEBVAULT

# Contact info (Zalo CTA + footer)
NEXT_PUBLIC_ZALO_PHONE=0987654321
NEXT_PUBLIC_ZALO_URL=
NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_EMAIL=hello@webvault.vn
NEXT_PUBLIC_ADDRESS=Quận 1, TP.HCM

# Optional: protect /api/_warm cron endpoint
WARM_SECRET=
